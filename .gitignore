# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.id_rsa
*.zip
*.tar
*.tar.gz

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# firebase local emulator & cache
.firebase/
*service-account*.json
*firebase-adminsdk*.json
scratch/

# local agent / mcp credentials
.agents/mcp_config.json

# vercel
.vercel

# typescript & test
*.tsbuildinfo
next-env.d.ts
vitest.config.ts.timestamp*
