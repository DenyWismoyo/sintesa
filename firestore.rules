rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION / ROLES
    // =========================================================================

    function isAuth() {
      return request.auth != null;
    }

    // Mengambil role untuk catalog admin portal (dari JWT 'role' claim atau Firestore users)
    // Pegawai STP kini tidak punya 'role' claim → default 'public' (aman, tidak dapat akses admin catalog)
    function getRole() {
      return isAuth() ? (
        request.auth.token.role != null 
          ? request.auth.token.role 
          : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
              : 'public')
      ) : 'public';
    }

    // Mengambil role untuk sistem presensi Techno Sign (dari JWT 'presensiRole' claim)
    // Digunakan khusus untuk koleksi presensi, lkh, izin, lembur, dll.
    function getPresRole() {
      return isAuth() ? (
        request.auth.token.presensiRole != null
          ? request.auth.token.presensiRole
          : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
              : 'pegawai')
      ) : null;
    }

    function isSuperAdmin() {
      return isAuth() && getRole() == 'super_admin';
    }

    function isAdmin() {
      return isAuth() && (getRole() in ['super_admin', 'admin']);
    }

    // Admin untuk sistem presensi (bisa catalog admin ATAU presensi admin)
    function isPresAdmin() {
      return isAdmin() || (isAuth() && getPresRole() == 'admin');
    }

    // Atasan atau admin untuk sistem presensi
    function isPresAtasanOrAdmin() {
      return isPresAdmin() || (isAuth() && getPresRole() == 'atasan');
    }

    function hasAnyRole(roles) {
      return isAuth() && (getRole() in roles || isSuperAdmin());
    }

    function isOwnTenant(tenantId) {
      return isAuth() && (
        (request.auth.token.tenantId != null && request.auth.token.tenantId == tenantId) ||
        (request.auth.uid == tenantId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    function isOwnPartner(partnerId) {
      return isAuth() && partnerId != null && partnerId != '' && (
        (request.auth.token.partnerId != null && request.auth.token.partnerId == partnerId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('partnerId', '') == partnerId)
      );
    }

    // Seluruh peran staf internal Solo Technopark
    function isInternalStaffRole() {
      return hasAnyRole([
        'super_admin',
        'admin',
        'admin_pelatihan',
        'operator_pelatihan',
        'admin_tenant',
        'operator_tenant',
        'admin_aset',
        'operator_aset',
        'admin_keuangan',
        'kasir',
        'kasir_pengeluaran',
        'admin_produksi',
        'operator_produksi',
        'pegawai'
      ]);
    }

    // Hak akses umum ekosistem forum alumni & jembatan industri
    function canAccessForum() {
      return hasAnyRole(['alumni', 'industri', 'tenant']) || isInternalStaffRole();
    }

    // Isolasi Mutlak Dua Zona Forum:
    // - ZONE_A_ALUMNI_ONLY: HANYA 'alumni' dan staf internal (MENOLAK KERAS 'industri' & 'tenant')
    // - ZONE_B_INDUSTRY_BRIDGE: Terbuka bagi 'alumni', 'industri', 'tenant', dan staf internal
    function canAccessForumZone(zone) {
      return (zone == 'ZONE_A_ALUMNI_ONLY' && (hasAnyRole(['alumni']) || isInternalStaffRole())) ||
             (zone == 'ZONE_B_INDUSTRY_BRIDGE' && (hasAnyRole(['alumni', 'industri', 'tenant']) || isInternalStaffRole()));
    }

    // =========================================================================
    // ROOT COLLECTIONS (MASTER DATA)
    // =========================================================================

    // 1. Data User & Akun
    match /users/{userId} {
      // User dapat membaca profilnya sendiri, atau tim admin terkait dapat meninjau akun user
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant'])
      );
      // User yang login diizinkan membuat dokumen profil awalnya sendiri tanpa klaim privilese admin/mitra/alumni
      allow create: if isAdmin() || (
        isAuth() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role in ['public', 'tenant', 'pegawai']) &&
        !request.resource.data.keys().hasAny(['partnerId', 'alumniId', 'isAlumni', 'isInstructor'])
      );
      // Admin dapat mengupdate profil siapa saja, user biasa hanya profil miliknya tanpa eskalasi role/relasi
      allow update: if isAdmin() || (
        isAuth() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tenantId', 'partnerId', 'alumniId', 'isAlumni', 'isInstructor'])
      );
      // Hanya Super Admin yang dapat menghapus akun
      allow delete: if isSuperAdmin();
    }

    // 2. Data Tenant & Startup Inkubasi
    match /tenants/{tenantId} {
      // Terbuka untuk umum atau user login untuk direktori profil ekosistem
      allow read: if true;
      // Admin tenant & Super Admin memiliki hak create, serta pendaftar kurasi baru berstatus 'Menunggu Review'
      allow create: if hasAnyRole(['admin', 'super_admin', 'admin_tenant']) || 
                      (request.resource.data.status == 'Menunggu Review');
      // Update dapat dilakukan oleh admin, atau tenant yang bersangkutan
      allow update: if hasAnyRole(['admin', 'super_admin', 'admin_tenant', 'operator_tenant']) || isOwnTenant(tenantId);
      // Hapus hanya oleh admin tenant atau super admin
      allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_tenant']);

      // Sub-koleksi Produk Tenant
      match /products/{productId} {
        allow read: if true;
        // Create dibatasi: admin/operator, tenant pemilik, atau alur kurasi publik (status draft_kurasi)
        allow create: if hasAnyRole(['admin', 'super_admin', 'admin_tenant', 'operator_tenant']) ||
                       isOwnTenant(tenantId) ||
                       (request.resource.data.status == 'draft_kurasi'); // Kurasi self-assessment publik
        allow update, delete: if hasAnyRole(['admin', 'super_admin', 'admin_tenant', 'operator_tenant']) || isOwnTenant(tenantId);
      }

      // Sub-koleksi Tiket Bantuan Tenant (Helpdesk)
      match /tickets/{ticketId} {
        allow read: if isAuth() && (
          isOwnTenant(tenantId) || 
          hasAnyRole(['admin', 'super_admin', 'admin_tenant', 'operator_tenant', 'admin_aset'])
        );
        allow create: if isAuth() && (isOwnTenant(tenantId) || hasAnyRole(['admin', 'super_admin', 'admin_tenant']));
        allow update, delete: if isAuth() && (isOwnTenant(tenantId) || hasAnyRole(['admin', 'super_admin', 'admin_tenant']));
      }

      // Sub-koleksi tenant lainnya (Monev, KPI, Team, Milestones, Revenue, dll)
      match /{subCollection}/{subDocId} {
        allow read: if isAuth() && (
          hasAnyRole(['admin', 'super_admin', 'admin_tenant', 'operator_tenant', 'investor']) || 
          isOwnTenant(tenantId)
        );
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_tenant', 'operator_tenant']) || isOwnTenant(tenantId);
      }
    }

    // 3. Data Aset Kawasan & Fasilitas
    match /assets/{assetId} {
      // Publik dapat melihat daftar dan detail fasilitas
      allow read: if true;
      // Manajemen aset hanya oleh tim admin aset atau super admin
      allow write: if hasAnyRole(['admin', 'super_admin', 'admin_aset', 'operator_aset']);

      // Sub-koleksi riwayat pemeliharaan
      match /maintenance_records/{recordId} {
        allow read: if isAuth();
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_aset', 'operator_aset']);
      }
    }

    // 4. Laporan Kerusakan Aset (Publik / User)
    match /asset_reports/{reportId} {
      allow create: if true; // Publik dapat melaporkan kerusakan fasilitas
      allow read: if isAuth() && (
        hasAnyRole(['admin', 'super_admin', 'admin_aset', 'operator_aset']) ||
        (resource.data.reporterEmail == request.auth.token.email)
      );
      allow update, delete: if hasAnyRole(['admin', 'super_admin', 'admin_aset', 'operator_aset']);
    }

    // 5. Program Pelatihan (Diklat, LMS & Training)
    match /trainings/{trainingId} {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);

      // Sub-koleksi 4 Batch Kuartalan
      match /batches/{batchId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      }

      // Sub-koleksi pendaftaran pelatihan (Online, Offline, Walk-in, Kemitraan)
      match /registrations/{regId} {
        allow create: if true; // Mendukung pendaftaran publik online, walk-in, gratis maupun berbayar
        allow read: if isAuth() && (
          hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']) ||
          resource.data.email == request.auth.token.email ||
          resource.data.userId == request.auth.uid ||
          (request.auth.uid in get(/databases/$(database)/documents/trainings/$(trainingId)).data.get('authorizedInstructorIds', []))
        );
        allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']) || (
          isAuth() &&
          (resource.data.email == request.auth.token.email || resource.data.userId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedLessons', 'lastAccessedAt', 'updatedAt', 'progress', 'status', 'invoiceId'])
        ) || (
          isAuth() &&
          (request.auth.uid in get(/databases/$(database)/documents/trainings/$(trainingId)).data.get('authorizedInstructorIds', [])) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedLessons', 'updatedAt'])
        );
        allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);

        // Sub-koleksi pengumpulan tugas peserta (Submissions)
        match /submissions/{subId} {
          allow read: if isAuth() && (
            hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']) ||
            get(/databases/$(database)/documents/trainings/$(trainingId)/registrations/$(regId)).data.email == request.auth.token.email ||
            get(/databases/$(database)/documents/trainings/$(trainingId)/registrations/$(regId)).data.userId == request.auth.uid ||
            (request.auth.uid in get(/databases/$(database)/documents/trainings/$(trainingId)).data.get('authorizedInstructorIds', []))
          );
          allow create, update: if isAuth();
          allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan']);
        }
      }

      // Sub-koleksi eksplisit kurikulum, modul, materi & silabus (mencegah kebocoran registrations via wildcard)
      match /modules/{docId} {
        allow read: if isAuth();
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      }

      match /lessons/{docId} {
        allow read: if isAuth();
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      }

      match /syllabus/{docId} {
        allow read: if isAuth();
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      }

      match /materials/{docId} {
        allow read: if isAuth();
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      }
    }

    // 6. E-Katalog Produk Tenant
    match /catalogs/{catalogId} {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'super_admin', 'admin_tenant', 'operator_tenant']);
    }

    // 7. Data Master Alumni Pelatihan & Talent Pool
    match /alumnis/{alumniId} {
      // Proteksi ketat PII & registrationCode: hanya admin terkait, alumni pemilik klaim, atau mitra industri/tenant khusus pencari kerja aktif
      allow read: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) ||
        (isAuth() && resource.data.claimedByUserId == request.auth.uid) ||
        (hasAnyRole(['industri', 'tenant']) && resource.data.status == 'CLAIMED' && resource.data.isLookingForJob == true);
      // Klaim akun (DORMANT -> CLAIMED) ditangani eksklusif di server via Cloud Function claimAlumniAccount (Admin SDK)
      allow create, delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']) || (
        isAuth() &&
        resource.data.claimedByUserId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['registrationCode', 'claimedByUserId', 'status', 'isVerified'])
      );
    }

    // 8. Event & Agenda Publik
    match /events/{eventId} {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']);
    }

    // 9. Tanya Jawab (FAQs)
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Konten Krenova
    match /krenova_contents/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Kolaborasi Ekosistem (Hub Threads & Responses)
    match /hub_threads/{threadId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin()
      );
    }

    match /hub_responses/{responseId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin()
      );
    }

    // 12. Artikel, Berita & Panduan Edukasi
    match /articles/{articleId} {
      // Publik dapat membaca seluruh artikel terbit dan konten warta edukasi
      allow read: if true;

      // Admin & operator pengelola memiliki wewenang penuh membuat dan menghapus artikel
      allow create, delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant', 'operator_pelatihan', 'operator_tenant']);

      // Admin dapat mengupdate seluruh isi artikel.
      // Publik / pembaca diizinkan mengupdate hanya field viewCount (counter atomik)
      allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant', 'operator_pelatihan', 'operator_tenant']) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
      );
    }

    // 13. Bursa Lowongan Pekerjaan & Karir Alumni Solo Technopark
    match /jobs/{jobId} {
      // Publik & SSR/API membaca daftar lowongan aktif (draft mitra berstatus isActive: false)
      allow read: if true;
      // Pembuatan lowongan oleh admin karir/pelatihan/tenant, atau draft oleh mitra industri/tenant
      allow create: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) || (
        hasAnyRole(['industri', 'tenant']) &&
        request.resource.data.approvalStatus == 'PENDING_APPROVAL' &&
        request.resource.data.isActive == false &&
        request.resource.data.submittedByUid == request.auth.uid
      );
      // Pembaruan penuh oleh admin karir/pelatihan/tenant, atau revisi draft oleh mitra pengaju sebelum disetujui
      allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) || (
        hasAnyRole(['industri', 'tenant']) &&
        resource.data.submittedByUid == request.auth.uid &&
        resource.data.approvalStatus == 'PENDING_APPROVAL' &&
        request.resource.data.approvalStatus == 'PENDING_APPROVAL' &&
        request.resource.data.isActive == false &&
        request.resource.data.submittedByUid == request.auth.uid
      );
      // Penghapusan lowongan hanya oleh admin karir/pelatihan/tenant
      allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']);

      // Sub-koleksi Lamaran Pekerjaan (Job Applications)
      match /applications/{appId} {
        // Pelamar membaca lamarannya sendiri; Tim pengelola karir & mitra/tenant pemilik lowongan dapat meninjau berkas
        allow read: if isAuth() && (
          resource.data.applicantId == request.auth.uid ||
          resource.data.applicantEmail == request.auth.token.email ||
          hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) ||
          (hasAnyRole(['industri', 'tenant']) &&
           exists(/databases/$(database)/documents/jobs/$(jobId)) && (
             get(/databases/$(database)/documents/jobs/$(jobId)).data.get('submittedByUid', '') == request.auth.uid ||
             (get(/databases/$(database)/documents/jobs/$(jobId)).data.get('partnerId', '') != '' &&
              isOwnPartner(get(/databases/$(database)/documents/jobs/$(jobId)).data.partnerId)) ||
             (get(/databases/$(database)/documents/jobs/$(jobId)).data.get('tenantId', '') != '' &&
              isOwnTenant(get(/databases/$(database)/documents/jobs/$(jobId)).data.tenantId))
           ))
        );
        // Pelamar terautentikasi dapat mengirimkan berkas lamaran
        allow create: if isAuth();
        // Pembaruan status seleksi oleh tim pengelola karir atau mitra/tenant pemilik lowongan
        allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) || (
          hasAnyRole(['industri', 'tenant']) &&
          exists(/databases/$(database)/documents/jobs/$(jobId)) && (
            get(/databases/$(database)/documents/jobs/$(jobId)).data.get('submittedByUid', '') == request.auth.uid ||
            (get(/databases/$(database)/documents/jobs/$(jobId)).data.get('partnerId', '') != '' &&
             isOwnPartner(get(/databases/$(database)/documents/jobs/$(jobId)).data.partnerId)) ||
            (get(/databases/$(database)/documents/jobs/$(jobId)).data.get('tenantId', '') != '' &&
             isOwnTenant(get(/databases/$(database)/documents/jobs/$(jobId)).data.tenantId))
          )
        );
        allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']);
      }
    }

    // 14. Program Kemitraan Afiliasi & Referral Marketing
    match /affiliates/{userId} {
      // Terbuka untuk membaca verifikasi kode referral aktif & direktori mitra
      allow read: if true;
      // Pendaftaran mitra baru oleh user terautentikasi untuk ID-nya sendiri
      allow create: if isAuth() && request.auth.uid == userId;
      // Update oleh mitra pemilik, admin, atau pembaca publik yang hanya menginkremen totalClicks
      allow update: if (isAuth() && request.auth.uid == userId) || 
                       hasAnyRole(['admin', 'super_admin', 'admin_keuangan']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalClicks']);
      allow delete: if hasAnyRole(['admin', 'super_admin']);
    }

    // Catatan Klik Referral Pengunjung Publik
    match /affiliate_clicks/{clickId} {
      allow create: if true; // Pengunjung publik mencatat klik rujukan
      allow read, write: if hasAnyRole(['admin', 'super_admin', 'admin_keuangan']);
    }

    // Rekam Komisi Afiliasi (Transaksi Keuangan)
    match /commissions/{commissionId} {
      allow read: if isAuth() && (
        resource.data.affiliateId == request.auth.uid || 
        hasAnyRole(['admin', 'super_admin', 'admin_keuangan'])
      );
      allow write: if hasAnyRole(['admin', 'super_admin', 'admin_keuangan', 'kasir']);
    }

    // Pengajuan Pencairan Saldo Komisi (Payout)
    match /affiliate_payouts/{payoutId} {
      allow read: if isAuth() && (
        resource.data.affiliateId == request.auth.uid || 
        hasAnyRole(['admin', 'super_admin', 'admin_keuangan'])
      );
      allow create: if isAuth() && request.resource.data.affiliateId == request.auth.uid;
      allow update, delete: if hasAnyRole(['admin', 'super_admin', 'admin_keuangan']);
    }

    // Konfigurasi Sistem Afiliasi, Sinkronisasi Lowongan & Pengaturan Umum
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan']);
    }

    // 15. Mitra Resmi Industri & Ekosistem (Official Partners)
    match /partners/{partnerId} {
      allow read: if isAuth() && (
        isOwnPartner(partnerId) ||
        resource.data.picUserId == request.auth.uid ||
        hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant', 'admin_aset', 'alumni'])
      );
      allow create, delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant', 'admin_aset']);
      allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant', 'admin_aset']) || (
        isAuth() &&
        (isOwnPartner(partnerId) || resource.data.picUserId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'isVerified', 'status', 'picUserId', 'inquiryId'])
      );
    }

    // =========================================================================
    // MULTI-TENANT TRANSAKSI & ARTIFACTS
    // Path: /artifacts/{appId}/public/data/{collection}/{docId}
    // =========================================================================
    match /artifacts/{appId}/public/data {

      // Master Cache (Read publik, ditulis oleh Cloud Functions / Admin)
      match /cache_tenants/{docId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_tenant']);
      }

      match /cache_assets/{docId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_aset']);
      }

      match /cache_catalogs/{docId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_tenant']);
      }

      match /cache_alumnis/{docId} {
        // Dibatasi khusus tim admin untuk melindungi PII (phone, address, birthInfo, registrationCode)
        allow read: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']);
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      }

      match /cache_talent_pool/{docId} {
        // Cache talenta pencari kerja yang telah disanitasi dari PII sensitif
        allow read: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant', 'industri', 'tenant', 'alumni']);
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      }

      match /cache_trainings/{docId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan']);
      }

      match /cache_jobs/{docId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']);
      }

      // Lowongan Pekerjaan & Karir Alumni Multi-tenant
      match /jobs/{jobId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']);
      }

      // Peta Kawasan & Hotspots
      match /map_settings/{docId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_aset']);
      }
      match /map_hotspots/{docId} {
        allow read: if true;
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_aset']);
      }

      // Peminjaman / Bookings
      match /bookings/{bookingId} {
        allow read: if true;
        allow create: if isAuth();
        allow update, delete: if hasAnyRole(['admin', 'super_admin', 'admin_aset', 'operator_aset']);
      }

      // Invoices & Billing
      match /invoices/{invoiceId} {
        // Terbuka untuk dibaca agar verifikasi nomor tagihan dan portal bukti bayar publik berfungsi
        allow read: if true;
        // Pembuatan dan perubahan tagihan oleh manajemen keuangan, kasir, dan seluruh admin sektoral (aset, tenant, pelatihan, produksi)
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_keuangan', 'kasir', 'admin_aset', 'admin_tenant', 'admin_pelatihan', 'admin_produksi']);
      }

      // Pengeluaran / Expenses
      match /expenses/{expenseId} {
        allow read, write: if hasAnyRole(['admin', 'super_admin', 'admin_keuangan', 'kasir_pengeluaran']);
      }

      // Akuntansi & Buku Besar (Bagan Akun, Jurnal, Anggaran)
      match /accounts/{accountId} {
        allow read, write: if hasAnyRole(['admin', 'super_admin', 'admin_keuangan', 'admin_aset', 'admin_tenant', 'admin_pelatihan', 'admin_produksi']);
      }
      match /journals/{journalId} {
        allow read, write: if hasAnyRole(['admin', 'super_admin', 'admin_keuangan', 'admin_aset', 'admin_tenant', 'admin_pelatihan', 'admin_produksi']);
      }
      match /budgets/{budgetId} {
        allow read, write: if hasAnyRole(['admin', 'super_admin', 'admin_keuangan']);
      }

      // Layanan Jasa Produksi & Manufaktur STP (Work Order & SPK)
      match /production_orders/{orderId} {
        allow read: if isAuth() && (
          hasAnyRole(['admin', 'super_admin', 'admin_produksi', 'operator_produksi', 'admin_keuangan', 'kasir']) ||
          resource.data.clientEmail == request.auth.token.email ||
          resource.data.userId == request.auth.uid
        );
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_produksi', 'operator_produksi']);
      }

      // Pesanan E-Katalog
      match /orders/{orderId} {
        allow create: if true;
        allow read: if isAuth() && (
          hasAnyRole(['admin', 'super_admin', 'admin_tenant']) ||
          resource.data.customerEmail == request.auth.token.email ||
          resource.data.userId == request.auth.uid
        );
        allow update, delete: if hasAnyRole(['admin', 'super_admin', 'admin_tenant']);
      }

      // Fasilitas Teknis & Perlengkapan Operasional (Add-ons B2B & Sewa Kawasan)
      match /facility_addons/{addonId} {
        // Terbuka dibaca publik untuk kalkulator simulasi paket B2B & sewa
        allow read: if true;
        // Penambahan, pengubahan, dan penghapusan hanya oleh pengelola aset & administrator
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_aset', 'operator_aset']);
      }

      // Kemitraan Strategis Industri & Pengajuan RFP / MoU
      match /partnership_inquiries/{inquiryId} {
        // Publik / calon mitra industri dapat mengajukan permohonan kerjasama
        allow create: if true;
        // Akses peninjauan dan pembaruan status oleh tim admin, tenant, aset & pelatihan
        allow read, update, delete: if hasAnyRole(['admin', 'super_admin', 'admin_tenant', 'admin_aset', 'admin_pelatihan']);
      }

      // Undangan Rekrutmen Talenta Alumni oleh Mitra Industri / Tenant
      match /talent_invitations/{invitationId} {
        allow create: if hasAnyRole(['industri', 'tenant', 'admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']) &&
          request.resource.data.senderUid == request.auth.uid;
        allow read: if isAuth() && (
          resource.data.senderUid == request.auth.uid ||
          hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) ||
          (request.auth.token.alumniId != null && resource.data.alumniId == request.auth.token.alumniId) ||
          (exists(/databases/$(database)/documents/alumnis/$(resource.data.alumniId)) &&
           get(/databases/$(database)/documents/alumnis/$(resource.data.alumniId)).data.claimedByUserId == request.auth.uid)
        );
        allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']) || (
          isAuth() &&
          ((request.auth.token.alumniId != null && resource.data.alumniId == request.auth.token.alumniId) ||
           (exists(/databases/$(database)/documents/alumnis/$(resource.data.alumniId)) &&
            get(/databases/$(database)/documents/alumnis/$(resource.data.alumniId)).data.claimedByUserId == request.auth.uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'respondedAt'])
        );
        allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan']);
      }

      // Kanal Ekosistem Forum Eksklusif 2 Zona (Sprint 3)
      match /alumni_forum_channels/{channelId} {
        allow read: if canAccessForum();
        allow write: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']);
      }

      // Thread Diskusi Forum Eksklusif dengan Isolasi Mutlak Dua Zona (Sprint 3)
      match /alumni_forum_threads/{threadId} {
        // ZONE_A_ALUMNI_ONLY tertutup mutlak dari 'industri' & 'tenant'; ZONE_B_INDUSTRY_BRIDGE terbuka bagi kolaborasi mitra/tenant
        allow read: if isAuth() && (
          hasAnyRole(['alumni']) ||
          isInternalStaffRole() ||
          resource.data.authorUid == request.auth.uid ||
          (resource.data.zone == 'ZONE_B_INDUSTRY_BRIDGE' && hasAnyRole(['industri', 'tenant']))
        );
        allow create: if isAuth() &&
          request.resource.data.authorUid == request.auth.uid &&
          canAccessForumZone(request.resource.data.zone);
        allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) || (
          isAuth() &&
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.zone == resource.data.zone &&
          request.resource.data.authorUid == resource.data.authorUid
        ) || (
          canAccessForumZone(resource.data.zone) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'upvotedByUids',
            'upvoteCount',
            'replyCount',
            'microProjectBrief',
            'eventAmaEmbed',
            'reportedCount',
            'acceptedReplyId',
            'updatedAt'
          ])
        );
        allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']) || (
          isAuth() && resource.data.authorUid == request.auth.uid
        );
      }

      // Balasan Diskusi Forum dengan Isolasi Mutlak Dua Zona (Sprint 3)
      match /alumni_forum_replies/{replyId} {
        allow read: if isAuth() && (
          hasAnyRole(['alumni']) ||
          isInternalStaffRole() ||
          resource.data.authorUid == request.auth.uid ||
          (resource.data.zone == 'ZONE_B_INDUSTRY_BRIDGE' && hasAnyRole(['industri', 'tenant']))
        );
        allow create: if isAuth() &&
          request.resource.data.authorUid == request.auth.uid &&
          canAccessForumZone(request.resource.data.zone);
        allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) || (
          isAuth() &&
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.zone == resource.data.zone &&
          request.resource.data.authorUid == resource.data.authorUid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['endorsedByMentor'])
        ) || (
          canAccessForumZone(resource.data.zone) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'upvotedByUids',
            'upvoteCount',
            'isAcceptedSolution',
            'reportedCount',
            'updatedAt'
          ])
        );
        allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']) || (
          isAuth() && resource.data.authorUid == request.auth.uid
        );
      }

      // Pelacakan Lamaran Kerja Closed-Loop (Sprint 4)
      match /job_applications/{applicationId} {
        allow create: if isAuth() && request.resource.data.applicantUid == request.auth.uid;
        allow read: if isAuth() && (
          resource.data.applicantUid == request.auth.uid ||
          hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) ||
          ('partnerId' in resource.data && resource.data.partnerId != null && resource.data.partnerId != '' && isOwnPartner(resource.data.partnerId)) ||
          ('tenantId' in resource.data && resource.data.tenantId != null && resource.data.tenantId != '' && isOwnTenant(resource.data.tenantId))
        );
        allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant']) || (
          (('partnerId' in resource.data && resource.data.partnerId != null && resource.data.partnerId != '' && isOwnPartner(resource.data.partnerId)) ||
           ('tenantId' in resource.data && resource.data.tenantId != null && resource.data.tenantId != '' && isOwnTenant(resource.data.tenantId))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusNote', 'updatedAt'])
        );
        allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']);
      }

      // Notifikasi Komunitas, Karir & Moderasi Ekosistem (Sprint 5)
      match /ecosystem_notifications/{notifId} {
        allow read: if isAuth() && (
          resource.data.recipientUid == request.auth.uid ||
          (resource.data.recipientUid == 'BROADCAST_ALUMNI' && (hasAnyRole(['alumni']) || isInternalStaffRole())) ||
          (resource.data.recipientUid == 'ADMIN_DESK' && hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan', 'admin_tenant'])) ||
          hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant'])
        );
        allow create: if isAuth() && (hasAnyRole(['alumni', 'industri', 'tenant']) || isInternalStaffRole());
        allow update: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'admin_tenant']) || (
          isAuth() &&
          (resource.data.recipientUid == request.auth.uid ||
           (resource.data.recipientUid == 'BROADCAST_ALUMNI' && (hasAnyRole(['alumni']) || isInternalStaffRole())) ||
           (resource.data.recipientUid == 'ADMIN_DESK' && hasAnyRole(['operator_pelatihan']))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByUids', 'isRead', 'updatedAt'])
        );
        allow delete: if hasAnyRole(['admin', 'super_admin', 'admin_pelatihan']);
      }

      // Pengaturan Umum Instansi
      match /settings/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // =========================================================================
    // MODUL TECHNO SIGN: PRESENSI, LOGBOOK KINERJA & TITIK GEOFENCING
    // Database: presensi-pegawai (atau default jika fallback)
    // =========================================================================

    // 13. Data Titik Kantor & Radius Geofencing
    match /kantor/{kantorId} {
      // Seluruh pegawai terautentikasi (presensi maupun catalog) dapat membaca titik kantor
      allow read: if isAuth();
      // Konfigurasi hanya oleh admin presensi atau admin catalog
      allow write: if isPresAdmin();
    }

    // 14. Rekam Presensi Harian (Check-In & Check-Out)
    match /presensi/{presensiId} {
      // Pegawai membaca miliknya sendiri; atasan/admin presensi membaca untuk pemantauan
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.atasanId == request.auth.uid ||
        isPresAtasanOrAdmin()
      );
      // Pegawai mencatat presensi sendiri
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid || isPresAdmin()
      );
      // Update (Check-Out) hanya oleh pemilik atau admin presensi
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || isPresAdmin()
      );
      allow delete: if isPresAdmin();
    }

    // 15. Laporan Kinerja Harian (LKH) / Logbook Pegawai
    match /lkh/{lkhId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.atasanId == request.auth.uid ||
        isPresAtasanOrAdmin()
      );
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid || isPresAdmin()
      );
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && resource.data.status in ['draft', 'rejected']) ||
        resource.data.atasanId == request.auth.uid ||
        isPresAdmin()
      );
      allow delete: if isAuth() && (
        (resource.data.userId == request.auth.uid && resource.data.status in ['draft', 'rejected']) ||
        isPresAdmin()
      );
    }

    // 16. Pengajuan Izin / Cuti
    match /izin/{izinId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.atasanId == request.auth.uid ||
        isPresAtasanOrAdmin()
      );
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid || isPresAdmin()
      );
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'diajukan') ||
        resource.data.atasanId == request.auth.uid ||
        isPresAdmin()
      );
      allow delete: if isAuth() && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'diajukan') ||
        isPresAdmin()
      );
    }

    // 17. Pengajuan & Rekam Lembur
        match /lemburRecords/{lemburId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.atasanId == request.auth.uid ||
        isPresAtasanOrAdmin()
      );
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid || isPresAdmin()
      );
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && resource.data.status in ['draft', 'diajukan']) ||
        resource.data.atasanId == request.auth.uid ||
        isPresAdmin()
      );
      allow delete: if isAuth() && (
        (resource.data.userId == request.auth.uid && resource.data.status in ['draft', 'diajukan']) ||
        isPresAdmin()
      );
    }

    // 17b. Pengajuan Revisi Presensi
    match /revisi_presensi/{revisiId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.atasanId == request.auth.uid ||
        isPresAtasanOrAdmin()
      );
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid || isPresAdmin()
      );
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && resource.data.status in ['menunggu', 'diajukan']) ||
        resource.data.atasanId == request.auth.uid ||
        isPresAdmin()
      );
      allow delete: if isAuth() && (
        (resource.data.userId == request.auth.uid && resource.data.status in ['menunggu', 'diajukan']) ||
        isPresAdmin()
      );
    }

    // 18. Organisasi & Unit Kerja
    match /organizations/{orgId} {
      allow read: if isAuth();
      allow write: if isPresAdmin(); // Admin presensi atau catalog admin
    }

    // 19. Audit Log Forensik Anti-Fraud (Immutable)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // =========================================================================
    // COLLECTION GROUP QUERIES
    // =========================================================================

    // Query CollectionGroup Registrations untuk halaman profil peserta & riwayat kursus
    match /{path=**}/registrations/{registrationId} {
      allow read: if isAuth() && (
        resource.data.email == request.auth.token.email ||
        resource.data.userId == request.auth.uid ||
        hasAnyRole(['admin', 'super_admin', 'admin_pelatihan', 'operator_pelatihan'])
      );
    }

    // Default Deny: Seluruh path koleksi/dokumen lain yang tidak didefinisikan secara eksplisit otomatis ditolak.
  }
}

